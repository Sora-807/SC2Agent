# LLM client (OpenAI-compatible). agentic works without these in tests (FakeLLMClient);
# set them to use the real OpenAIClient.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=glm-5.2
# Optional thinking-model controls (GLM): "true"/"false" toggles; unset = server default.
# LLM_ENABLE_THINKING=
# LLM_REASONING_EFFORT=high
